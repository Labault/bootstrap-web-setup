# Managed by bootstrap (wordpress profile). PHPStan level 9 with WordPress
# stubs and dynamic return types supplied by szepeviktor/phpstan-wordpress.
includes:
	- vendor/phpstan/phpstan-phpunit/extension.neon
	- vendor/phpstan/phpstan-phpunit/rules.neon
	- vendor/szepeviktor/phpstan-wordpress/extension.neon

parameters:
	level: 9
	scanFiles:
		- vendor/phpunit/phpunit/src/Framework/Assert.php
		- vendor/phpunit/phpunit/src/Framework/TestCase.php
	paths:
		- .
	excludePaths:
		analyse:
			- node_modules (?)
			- vendor
			- wp-admin (?)
			- wp-content/cache (?)
			- wp-content/languages (?)
			- wp-content/upgrade (?)
			- wp-content/uploads (?)
			- wp-includes (?)
			- wp-*.php
