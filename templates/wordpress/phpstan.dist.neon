# Managed by bootstrap (wordpress profile). PHPStan level 9 with WordPress
# stubs and dynamic return types supplied by szepeviktor/phpstan-wordpress.
includes:
	- vendor/phpstan/phpstan-phpunit/extension.neon
	- vendor/phpstan/phpstan-phpunit/rules.neon
	- vendor/szepeviktor/phpstan-wordpress/extension.neon

parameters:
	level: 9
	scanFiles:
		- vendor/phpunit/phpunit/src/Framework/Assert.php
		- vendor/phpunit/phpunit/src/Framework/TestCase.php
	paths:
		- .
	excludePaths:
		analyse:
			- node_modules (?)
			- vendor
			- wp-admin (?)
			- wp-content/cache (?)
			- wp-content/languages (?)
			- wp-content/upgrade (?)
			- wp-content/uploads (?)
			- wp-includes (?)
			- wp-activate.php (?)
			- wp-blog-header.php (?)
			- wp-comments-post.php (?)
			- wp-config.php (?)
			- wp-cron.php (?)
			- wp-links-opml.php (?)
			- wp-load.php (?)
			- wp-login.php (?)
			- wp-mail.php (?)
			- wp-settings.php (?)
			- wp-signup.php (?)
			- wp-trackback.php (?)
			- xmlrpc.php (?)
